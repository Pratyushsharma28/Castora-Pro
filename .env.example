# Castora Pro Server Configuration
PORT=3000
NODE_ENV=development
DISABLE_HMR=true

# Optional Signaling Room TTL (milliseconds)
CASTORA_ROOM_TTL_MS=

# Optional LAN HTTPS/WSS TLS Certificates
CASTORA_TLS_CERT=
CASTORA_TLS_KEY=

# Optional STUN & TURN Relay Configuration (server-side only; never prefix with VITE_)
# Supports UDP, TCP, and TLS TURN URLs (comma-separated).
# Example TURN URLs:
#   turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
CASTORA_STUN_URLS=
CASTORA_TURN_URLS=
# Recommended: Coturn / TURN REST shared secret for time-limited HMAC-SHA1 temporary credentials
CASTORA_TURN_AUTH_SECRET=
CASTORA_TURN_TTL_SECONDS=3600
# Optional static TURN credentials (used only when CASTORA_TURN_AUTH_SECRET is unset)
CASTORA_TURN_USERNAME=
CASTORA_TURN_CREDENTIAL=

# Gemini API Key (server-side only, if enabled)
GEMINI_API_KEY=
