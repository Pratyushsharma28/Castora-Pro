{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pratyushsharma28/Castora-Pro/protocol/castora-protocol.schema.json",
  "title": "Castora Pro Signaling Protocol (castora.v1)",
  "description": "Strict cross-platform JSON signaling contract for macOS (Swift), Android (Kotlin), and Android TV (Kotlin) Castora Pro applications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "messageType",
    "messageId",
    "senderDeviceId",
    "receiverDeviceId",
    "roomId",
    "timestamp",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/protocolVersion"
    },
    "messageType": {
      "$ref": "#/$defs/messageType"
    },
    "messageId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "senderDeviceId": {
      "$ref": "#/$defs/deviceId"
    },
    "receiverDeviceId": {
      "oneOf": [
        { "$ref": "#/$defs/deviceId" },
        { "type": "null" }
      ]
    },
    "roomId": {
      "oneOf": [
        { "$ref": "#/$defs/roomId" },
        { "type": "null" }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "messageType": { "const": "device_announce" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/deviceAnnouncePayload" } } }
    },
    {
      "if": { "properties": { "messageType": { "const": "device_discover" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/deviceDiscoverPayload" } } }
    },
    {
      "if": { "properties": { "messageType": { "const": "pair_request" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/pairRequestPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "pair_response" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/pairResponsePayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "connection_request" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/connectionRequestPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "connection_accepted" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/connectionAcceptedPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "connection_rejected" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/connectionRejectedPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "session_offer" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/sessionOfferPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "session_answer" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/sessionAnswerPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "ice_candidate" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/iceCandidatePayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "stream_start" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/streamStartPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "stream_stop" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/streamStopPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "stream_status" } } },
      "then": {
        "properties": {
          "receiverDeviceId": { "$ref": "#/$defs/deviceId" },
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/streamStatusPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "disconnect" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/disconnectPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "error" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/errorPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "heartbeat" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/heartbeatPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "room_state" } } },
      "then": {
        "properties": {
          "roomId": { "$ref": "#/$defs/roomId" },
          "payload": { "$ref": "#/$defs/roomStatePayload" }
        }
      }
    }
  ],
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "const": "castora.v1"
    },
    "messageType": {
      "type": "string",
      "enum": [
        "device_announce",
        "device_discover",
        "pair_request",
        "pair_response",
        "connection_request",
        "connection_accepted",
        "connection_rejected",
        "session_offer",
        "session_answer",
        "ice_candidate",
        "stream_start",
        "stream_stop",
        "stream_status",
        "disconnect",
        "error",
        "heartbeat",
        "room_state"
      ]
    },
    "deviceId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "roomId": {
      "type": "string",
      "pattern": "^[A-Z0-9]{6}$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "streamId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "platform": {
      "type": "string",
      "enum": ["macos", "android", "android-tv"]
    },
    "detectedDeviceType": {
      "type": "string",
      "enum": ["Mac", "Windows", "Linux", "iPad", "iPhone", "Android", "TV", "Chromebook", "Unknown"]
    },
    "deviceRole": {
      "type": "string",
      "enum": ["sender", "receiver", "both"]
    },
    "videoCodec": {
      "type": "string",
      "enum": ["H264", "HEVC", "VP8", "VP9", "AV1"]
    },
    "ephemeralNonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWidth", "maxHeight", "maxFps", "codecs", "supportsAudio"],
      "properties": {
        "maxWidth": { "type": "integer", "minimum": 640, "maximum": 7680 },
        "maxHeight": { "type": "integer", "minimum": 360, "maximum": 4320 },
        "maxFps": { "type": "integer", "minimum": 15, "maximum": 120 },
        "codecs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/videoCodec" }
        },
        "supportsAudio": { "type": "boolean" }
      }
    },
    "iceServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls"],
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "deviceAnnouncePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceName", "platform", "role", "wsPort", "capabilities"],
      "properties": {
        "deviceName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "$ref": "#/$defs/platform" },
        "role": { "$ref": "#/$defs/deviceRole" },
        "wsPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "deviceDiscoverPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedRole", "requesterPlatform"],
      "properties": {
        "requestedRole": {
          "type": "string",
          "enum": ["sender", "receiver", "any"]
        },
        "requesterPlatform": { "$ref": "#/$defs/platform" },
        "filterPlatform": {
          "oneOf": [
            { "$ref": "#/$defs/platform" },
            { "type": "null" }
          ]
        }
      }
    },
    "pairRequestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairingMethod", "ephemeralNonce", "deviceName", "platform", "capabilities"],
      "properties": {
        "pairingMethod": {
          "type": "string",
          "enum": ["qr", "room_code", "manual_ip"]
        },
        "ephemeralNonce": { "$ref": "#/$defs/ephemeralNonce" },
        "deviceName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "$ref": "#/$defs/platform" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "pairResponsePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paired", "reason", "receiverName", "receiverPlatform", "sessionId"],
      "properties": {
        "paired": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "receiverName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "receiverPlatform": { "$ref": "#/$defs/platform" },
        "sessionId": {
          "oneOf": [
            { "$ref": "#/$defs/sessionId" },
            { "type": "null" }
          ]
        }
      }
    },
    "connectionRequestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "streamId", "senderName", "senderPlatform", "requestedQuality"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "senderPlatform": { "$ref": "#/$defs/platform" },
        "requestedQuality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetWidth", "targetHeight", "targetFps", "preferredCodec"],
          "properties": {
            "targetWidth": { "type": "integer", "minimum": 640, "maximum": 3840 },
            "targetHeight": { "type": "integer", "minimum": 360, "maximum": 2160 },
            "targetFps": { "type": "integer", "minimum": 15, "maximum": 120 },
            "preferredCodec": { "$ref": "#/$defs/videoCodec" }
          }
        }
      }
    },
    "connectionAcceptedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "streamId", "assignedSlotIndex", "iceConfig"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "assignedSlotIndex": { "type": "integer", "minimum": 0, "maximum": 15 },
        "iceConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["iceServers"],
          "properties": {
            "iceServers": {
              "type": "array",
              "items": { "$ref": "#/$defs/iceServer" }
            }
          }
        }
      }
    },
    "connectionRejectedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "reasonCode", "message"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "reasonCode": {
          "type": "string",
          "enum": ["USER_DECLINED", "SESSION_FULL", "CAPABILITY_MISMATCH", "TIMEOUT"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "sessionOfferPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "streamId", "sdpType", "sdp"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "sdpType": { "type": "string", "const": "offer" },
        "sdp": { "type": "string", "minLength": 10, "maxLength": 32768, "pattern": "^v=0" },
        "mediaInfo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hasVideo", "hasAudio"],
          "properties": {
            "hasVideo": { "type": "boolean" },
            "hasAudio": { "type": "boolean" },
            "codecHint": { "$ref": "#/$defs/videoCodec" }
          }
        }
      }
    },
    "sessionAnswerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "streamId", "sdpType", "sdp"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "sdpType": { "type": "string", "const": "answer" },
        "sdp": { "type": "string", "minLength": 10, "maxLength": 32768, "pattern": "^v=0" }
      }
    },
    "iceCandidatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "streamId", "sdpMid", "sdpMLineIndex", "candidate"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "sdpMid": { "type": ["string", "null"] },
        "sdpMLineIndex": { "type": "integer", "minimum": 0 },
        "candidate": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "streamStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "streamId", "width", "height", "fps", "codec"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "codec": { "$ref": "#/$defs/videoCodec" }
      }
    },
    "streamStopPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "streamId", "reason"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "reason": {
          "type": "string",
          "enum": ["user_stopped", "receiver_closed", "capture_revoked", "network_lost"]
        }
      }
    },
    "streamStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "streamId", "state", "layoutMode"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "state": {
          "type": "string",
          "enum": ["starting", "active", "paused", "degraded"]
        },
        "layoutMode": {
          "type": "string",
          "enum": ["grid", "fullscreen"]
        },
        "measuredStats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fps", "bitrateKbps", "rttMs", "droppedFrames"],
          "properties": {
            "fps": { "type": "number", "minimum": 0 },
            "bitrateKbps": { "type": "number", "minimum": 0 },
            "rttMs": { "type": "number", "minimum": 0 },
            "droppedFrames": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "disconnectPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "streamId", "reason"],
      "properties": {
        "sessionId": {
          "oneOf": [
            { "$ref": "#/$defs/sessionId" },
            { "type": "null" }
          ]
        },
        "streamId": {
          "oneOf": [
            { "$ref": "#/$defs/streamId" },
            { "type": "null" }
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "errorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "recoverable", "relatedMessageId"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "UNSUPPORTED_VERSION",
            "INVALID_MESSAGE",
            "INVALID_NONCE",
            "INVALID_ROOM_ID",
            "APPROVAL_DECLINED",
            "SESSION_FULL",
            "CAPTURE_PERMISSION_DENIED",
            "WEBRTC_NEGOTIATION_FAILED",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "recoverable": { "type": "boolean" },
        "relatedMessageId": { "type": ["string", "null"] }
      }
    },
    "heartbeatPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "role"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "role": {
          "type": "string",
          "enum": ["sender", "receiver"]
        }
      }
    },
    "roomStatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "hostDeviceId",
        "hostDeviceName",
        "hostPlatform",
        "hostConnected",
        "expiresAt",
        "maxReceivers",
        "pendingRequests",
        "pairedReceivers"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "closed", "expired"]
        },
        "hostDeviceId": { "$ref": "#/$defs/deviceId" },
        "hostDeviceName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "hostPlatform": { "$ref": "#/$defs/platform" },
        "hostDeviceType": { "$ref": "#/$defs/detectedDeviceType" },
        "hostConnected": { "type": "boolean" },
        "hostLastSeenAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "maxReceivers": { "type": "integer", "minimum": 1, "maximum": 16 },
        "pendingRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deviceId", "deviceName", "platform", "pairingMethod", "connected", "requestedAt", "sessionId"],
            "properties": {
              "deviceId": { "$ref": "#/$defs/deviceId" },
              "deviceName": { "type": "string", "minLength": 1, "maxLength": 64 },
              "platform": { "$ref": "#/$defs/platform" },
              "deviceType": { "$ref": "#/$defs/detectedDeviceType" },
              "pairingMethod": { "type": "string", "enum": ["qr", "room_code", "manual_ip"] },
              "connected": { "type": "boolean" },
              "requestedAt": { "type": "string", "format": "date-time" },
              "lastSeenAt": { "type": "string", "format": "date-time" },
              "sessionId": { "$ref": "#/$defs/sessionId" }
            }
          }
        },
        "pairedReceivers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deviceId", "deviceName", "platform", "connected", "assignedSlotIndex", "pairedAt", "sessionId"],
            "properties": {
              "deviceId": { "$ref": "#/$defs/deviceId" },
              "deviceName": { "type": "string", "minLength": 1, "maxLength": 64 },
              "platform": { "$ref": "#/$defs/platform" },
              "deviceType": { "$ref": "#/$defs/detectedDeviceType" },
              "connected": { "type": "boolean" },
              "assignedSlotIndex": { "type": "integer", "minimum": 0, "maximum": 15 },
              "pairedAt": { "type": "string", "format": "date-time" },
              "lastSeenAt": { "type": "string", "format": "date-time" },
              "sessionId": { "$ref": "#/$defs/sessionId" }
            }
          }
        },
        "activeStreams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "streamId",
              "sessionId",
              "publisherDeviceId",
              "publisherName",
              "publisherPlatform",
              "targetDeviceId",
              "width",
              "height",
              "fps",
              "codec",
              "startedAt"
            ],
            "properties": {
              "streamId": { "$ref": "#/$defs/streamId" },
              "sessionId": { "$ref": "#/$defs/sessionId" },
              "publisherDeviceId": { "$ref": "#/$defs/deviceId" },
              "publisherName": { "type": "string", "minLength": 1, "maxLength": 64 },
              "publisherPlatform": { "$ref": "#/$defs/platform" },
              "targetDeviceId": { "$ref": "#/$defs/deviceId" },
              "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
              "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
              "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
              "codec": { "$ref": "#/$defs/videoCodec" },
              "hasAudio": { "type": "boolean" },
              "startedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
